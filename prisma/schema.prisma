generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  ADMIN
  READ_WRITE
  READ_ONLY
}

/// Where a user's credentials are authenticated.
enum LoginType {
  LOCAL
  LDAP
}

/// Global authentication strategy selectable by administrators.
enum LoginMode {
  LOCAL_ONLY
  LDAP_ONLY
  LOCAL_AND_LDAP
}

enum SiteStatus {
  ACTIVE
  PLANNED
  INACTIVE
  DECOMMISSIONED
}

enum OdfStatus {
  ACTIVE
  PLANNED
  INACTIVE
  DECOMMISSIONED
}

enum ResourceStatus {
  ACTIVE
  AVAILABLE
  USED
  SPARE
  RESERVED
  FAULTY
  DUMMY
  PLANNED
  UNKNOWN
  MAINTENANCE
  INACTIVE
  DECOMMISSIONED
}

enum PortGroupType {
  SINGLE
  PAIR
  CUSTOM
}

enum EndpointSide {
  A
  B
}

enum ServiceStatus {
  ACTIVE
  PLANNED
  SUSPENDED
  PROTECTION
  TEMPORARY
  DECOMMISSIONED
}

enum RouteType {
  WORKING
  PROTECTION
  TEMPORARY
  RESTORATION
}

enum MetricType {
  SEGMENT_UTILIZATION
  SITE_PAIR_UTILIZATION
  ODF_UTILIZATION
  CABLE_UTILIZATION
}

enum AlertType {
  HIGH_UTILIZATION
  MISSING_FAR_END_MAPPING
  MISSING_CABLE_INFORMATION
  PARTIAL_TERMINATION
  IMPORT_WARNING
  DATA_GAP
  DUPLICATE_MAPPING
  FAULTY_FIBER_COUNT
  CUTOVER_RISK
  SINGLE_POINT_OF_FAILURE
  SPUR_ENDPOINT_RISK
  CUSTOM
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

enum AlertState {
  OPEN
  ACKNOWLEDGED
  SUPPRESSED
  CLEARED
}

enum NotificationChannel {
  EMAIL
  SMS
  MOBILE_PUSH
  IN_APP
  NONE
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATED
  REVIEW_REQUIRED
  COMMITTED
  PARTIAL_FAILED
  FAILED
}

enum ImportRowStatus {
  STAGED
  VALID
  WARNING
  ERROR
  APPROVED
  REJECTED
  COMMITTED
  SKIPPED
}

enum IssueSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum ChangeAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
  EXPORT
  RESERVE
  RELEASE
  ACKNOWLEDGE
  SUPPRESS
  CLEAR
  PASSWORD_RESET
  PASSWORD_CHANGE
  SMTP_UPDATE
  TEMPLATE_UPDATE
  ROLE_CHANGE
  MANUAL_OVERRIDE
  LOGIN
}

enum RecordSource {
  IMPORT
  MANUAL
  API
  SYSTEM
}

enum SplitterScope {
  ISP
  OSP
}

enum SplitterProtection {
  PROTECTED
  UNPROTECTED
  UNKNOWN
}

model Role {
  id              String           @id @default(cuid())
  code            RoleCode         @unique
  name            String
  description     String?
  permissionsJson String?
  users           User[]
  roleUsers       UserRole[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  /// LOCAL users keep a portal-managed scrypt hash; LDAP users have none and
  /// authenticate against the domain controller.
  loginType           LoginType            @default(LOCAL)
  passwordHash        String?
  passwordChangedAt   DateTime?
  forcePasswordChange Boolean              @default(false)
  // Account-lockout state. ADMIN / READ_WRITE local accounts lock after too many
  // failed logins; the lock is cleared only by entering the emailed unlock code
  // (or by an admin via the Users screen). LDAP users and the emergency account
  // are never locked here.
  failedLoginAttempts Int                  @default(0)
  lockedAt            DateTime?
  unlockCodeHash      String?
  unlockCodeExpiresAt DateTime?
  unlockCodeAttempts  Int                  @default(0)
  roleId              String
  isActive            Boolean              @default(true)
  lastLoginAt         DateTime?
  role                Role                 @relation(fields: [roleId], references: [id])
  roleLinks           UserRole[]
  temporaryPasswords  TemporaryPassword[]
  passwordResetTokens PasswordResetToken[]
  uploadedBatches     ImportBatch[]        @relation("ImportUploadedBy")
  reviewedBatches     ImportBatch[]        @relation("ImportReviewedBy")
  committedBatches    ImportBatch[]        @relation("ImportCommittedBy")
  createdSuppressions AlertSuppression[]   @relation("AlertSuppressionCreatedBy")
  acknowledgedAlerts  AlertEvent[]         @relation("AlertAcknowledgedBy")
  resolvedIssues      ImportIssue[]        @relation("ImportIssueResolvedBy")
  notificationLogs    NotificationLog[]    @relation("NotificationLogUser")
  auditLogs           AuditLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

/// Singleton (single active row) authentication configuration. Stores the
/// global Login Mode, the LDAP / Domain Controller connection, and the
/// emergency local fallback account used when the directory is unreachable.
model AuthSetting {
  id                      String    @id @default(cuid())
  loginMode               LoginMode @default(LOCAL_ONLY)
  ldapEnabled             Boolean   @default(false)
  ldapHost                String?
  ldapPort                Int?
  ldapUseSsl              Boolean   @default(true)
  ldapBaseDn              String?
  ldapBindDn              String?
  ldapBindPasswordEnc     String?
  ldapUserDnPattern       String?
  ldapUserAttribute       String?   @default("sAMAccountName")
  // Optional allow-list of domain usernames permitted to log in via LDAP
  // (comma/newline separated). Empty = no restriction beyond per-user records.
  ldapAllowedUsernames    String?
  emergencyAccountEnabled Boolean   @default(true)
  emergencyUsername       String    @default("portal.superadmin")
  emergencyAllowedIps     String?
  isActive                Boolean   @default(true)
  updatedById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  module          String
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  isPrimary Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model TemporaryPassword {
  id           String    @id @default(cuid())
  userId       String
  passwordHash String
  expiresAt    DateTime
  consumedAt   DateTime?
  reason       String?
  user         User      @relation(fields: [userId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Site {
  id                     String                      @id @default(cuid())
  code                   String                      @unique
  name                   String?
  region                 String?
  city                   String?
  siteType               String?
  label                  String?
  siteStructure          String?
  colocationType         String?
  colocationOwner        String?
  coordinateX            Float?
  coordinateY            Float?
  isFiberNode            Boolean                     @default(false)
  isCoreSite             Boolean                     @default(false)
  coreSiteType           String?
  // Operator-managed flags previously added at runtime via raw SQL; now schema-managed.
  isCriticalSite         Boolean                     @default(false)
  isDatacenter           Boolean                     @default(false)
  status                 SiteStatus                  @default(ACTIVE)
  remarks                String?
  aliases                SiteAlias[]
  criticalityTags        SiteCriticalityAssignment[]
  racks                  Rack[]
  odfs                   ODF[]
  portGroups             PortGroup[]
  segmentEndpoints       SegmentEndpoint[]
  serviceRouteHops       ServiceRouteHop[]
  serviceAllocationsFrom ServiceAllocation[]         @relation("ServiceAllocationFromSite")
  serviceAllocationsTo   ServiceAllocation[]         @relation("ServiceAllocationToSite")
  utilizationMetrics     UtilizationMetric[]         @relation("SiteUtilizationMetric")
  alertEvents            AlertEvent[]                @relation("SiteAlertEvent")
  attachments            SegmentAttachment[]
  cableSiteA             Cable[]                     @relation("CableSiteA")
  cableSiteB             Cable[]                     @relation("CableSiteB")
  normalizedRowsA        ImportStagingRow[]          @relation("StagingNormalizedSiteA")
  normalizedRowsB        ImportStagingRow[]          @relation("StagingNormalizedSiteB")
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([region])
  @@index([siteType])
  @@index([label])
  @@index([colocationType])
  @@index([isFiberNode])
  @@index([isCoreSite])
  @@index([coreSiteType])
  @@index([isCriticalSite])
  @@index([isDatacenter])
  @@index([status])
}

model SiteAlias {
  id              String       @id @default(cuid())
  siteId          String
  alias           String
  aliasNormalized String
  isPrimary       Boolean      @default(false)
  source          RecordSource @default(MANUAL)
  site            Site         @relation(fields: [siteId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([siteId, aliasNormalized])
  @@unique([aliasNormalized])
}

model SiteCriticalityTag {
  id          String                      @id @default(cuid())
  code        String                      @unique
  label       String
  assignments SiteCriticalityAssignment[]
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
}

model SiteCriticalityAssignment {
  id        String             @id @default(cuid())
  siteId    String
  tagId     String
  site      Site               @relation(fields: [siteId], references: [id])
  tag       SiteCriticalityTag @relation(fields: [tagId], references: [id])
  createdAt DateTime           @default(now())

  @@unique([siteId, tagId])
  @@index([tagId])
}

model Rack {
  id               String            @id @default(cuid())
  siteId           String
  rackCode         String
  name             String?
  status           OdfStatus         @default(ACTIVE)
  remarks          String?
  site             Site              @relation(fields: [siteId], references: [id])
  odfs             ODF[]
  portGroups       PortGroup[]
  segmentEndpoints SegmentEndpoint[]
  serviceRouteHops ServiceRouteHop[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([siteId, rackCode])
  @@index([siteId])
}

model ODF {
  id                 String              @id @default(cuid())
  siteId             String
  rackId             String
  odfCode            String
  name               String?
  status             OdfStatus           @default(ACTIVE)
  maxPorts           Int?
  remarks            String?
  site               Site                @relation(fields: [siteId], references: [id])
  rack               Rack                @relation(fields: [rackId], references: [id])
  ports              ODFPort[]
  portGroups         PortGroup[]
  segmentEndpoints   SegmentEndpoint[]
  serviceRouteHops   ServiceRouteHop[]
  utilizationMetrics UtilizationMetric[] @relation("OdfUtilizationMetric")
  alertEvents        AlertEvent[]        @relation("OdfAlertEvent")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([siteId, rackId, odfCode])
  @@index([siteId, odfCode])
  @@index([siteId, status])
  @@index([rackId, status])
  @@index([rackId])
}

model ODFPort {
  id              String            @id @default(cuid())
  odfId           String
  portNumber      Int
  label           String?
  fiberPortNumber Int?
  tubeNumber      Int?
  tubeColor       String?
  fiberNumber     Int?
  status          ResourceStatus    @default(AVAILABLE)
  isBlocked       Boolean           @default(false)
  remarks         String?
  odf             ODF               @relation(fields: [odfId], references: [id])
  groupMembers    PortGroupMember[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([odfId, portNumber])
  @@index([status])
  @@index([odfId, status])
  @@index([fiberPortNumber])
  @@index([tubeNumber])
  @@index([fiberNumber])
}

model PortGroup {
  id                     String                   @id @default(cuid())
  siteId                 String
  rackId                 String
  odfId                  String
  groupType              PortGroupType
  displayLabel           String
  startPortNumber        Int?
  endPortNumber          Int?
  fiberPortNumber        Int?
  fiberNumber            Int?
  tubeNumber             Int?
  tubeColor              String?
  status                 ResourceStatus           @default(AVAILABLE)
  reservationNote        String?
  remarks                String?
  source                 RecordSource             @default(MANUAL)
  site                   Site                     @relation(fields: [siteId], references: [id])
  rack                   Rack                     @relation(fields: [rackId], references: [id])
  odf                    ODF                      @relation(fields: [odfId], references: [id])
  members                PortGroupMember[]
  segmentEndpoints       SegmentEndpoint[]
  serviceRouteHops       ServiceRouteHop[]
  serviceAllocationsAsA  ServiceAllocation[]      @relation("ServiceAllocationEndpointAPortGroup")
  serviceAllocationsAsB  ServiceAllocation[]      @relation("ServiceAllocationEndpointBPortGroup")
  splitterOutputs        SplitterOutput[]
  segmentMappingsAsLocal SegmentEndpointMapping[] @relation("SegmentEndpointMappingLocalPortGroup")
  segmentMappingsAsFar   SegmentEndpointMapping[] @relation("SegmentEndpointMappingFarPortGroup")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@unique([odfId, displayLabel])
  @@index([siteId])
  @@index([rackId])
  @@index([status])
  @@index([odfId, status])
  @@index([fiberPortNumber])
  @@index([fiberNumber])
  @@index([tubeNumber])
}

model PortGroupMember {
  id          String    @id @default(cuid())
  portGroupId String
  odfPortId   String
  sequence    Int
  portGroup   PortGroup @relation(fields: [portGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  odfPort     ODFPort   @relation(fields: [odfPortId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([portGroupId, odfPortId])
  @@unique([portGroupId, sequence])
  @@index([odfPortId])
}

model Cable {
  id                 String              @id @default(cuid())
  cableCode          String?
  cableName          String?
  cableType          String?
  totalFibers        Int?
  routeLabel         String?
  distanceKm         Float?
  siteAId            String?
  siteBId            String?
  status             ResourceStatus      @default(ACTIVE)
  remarks            String?
  siteA              Site?               @relation("CableSiteA", fields: [siteAId], references: [id])
  siteB              Site?               @relation("CableSiteB", fields: [siteBId], references: [id])
  linkSegments       LinkSegment[]
  utilizationMetrics UtilizationMetric[] @relation("CableUtilizationMetric")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([cableCode])
  @@index([siteAId, siteBId])
  @@index([status])
}

model SegmentEndpoint {
  id                    String              @id @default(cuid())
  endpointSide          EndpointSide
  siteId                String?
  rackId                String?
  odfId                 String?
  portGroupId           String?
  rawSiteCode           String?
  rawRackCode           String?
  rawOdfCode            String?
  rawPortText           String?
  displayPortText       String?
  terminationStatus     ResourceStatus      @default(ACTIVE)
  remarks               String?
  site                  Site?               @relation(fields: [siteId], references: [id])
  rack                  Rack?               @relation(fields: [rackId], references: [id])
  odf                   ODF?                @relation(fields: [odfId], references: [id])
  portGroup             PortGroup?          @relation(fields: [portGroupId], references: [id])
  segmentAsA            LinkSegment?        @relation("LinkSegmentEndpointA")
  segmentAsB            LinkSegment?        @relation("LinkSegmentEndpointB")
  serviceAllocationsAsA ServiceAllocation[] @relation("ServiceAllocationEndpointA")
  serviceAllocationsAsB ServiceAllocation[] @relation("ServiceAllocationEndpointB")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([siteId])
  @@index([rackId])
  @@index([odfId])
  @@index([portGroupId])
  @@index([rawSiteCode])
}

model LinkSegment {
  id                    String                   @id @default(cuid())
  segmentCode           String                   @unique
  segmentGroupName      String?
  segmentSequence       String?
  segmentCapacityFibers Int?
  sourceSegmentKey      String?
  sourceWorkbook        String?
  sourceWorksheetName   String?
  spanType              String?
  inventoryClass        String?
  matchStatus           String?
  sitePairKey           String
  endpointAId           String                   @unique
  endpointBId           String                   @unique
  cableId               String?
  routeLabel            String?
  tubeNumber            Int?
  tubeColor             String?
  tubeLabel             String?
  fiberPortNumber       Int?
  fiberNumber           Int?
  fiberLabel            String?
  fiberCount            Int?
  totalFiberCapacity    Int                      @default(0)
  usableFiberCapacity   Int?
  usedFiberCount        Int                      @default(0)
  reservedFiberCount    Int                      @default(0)
  faultyFiberCount      Int                      @default(0)
  inactiveFiberCount    Int                      @default(0)
  dummyFiberCount       Int                      @default(0)
  availableFiberCount   Int                      @default(0)
  utilizationPct        Float                    @default(0)
  terminatedPairCount   Int?
  distanceKm            Float?
  status                ResourceStatus           @default(ACTIVE)
  isPartialTermination  Boolean                  @default(false)
  isMirrorCandidate     Boolean                  @default(false)
  manualOverride        Boolean                  @default(false)
  overrideReason        String?
  comments              String?
  allocatedServiceCode  String?
  allocationNote        String?
  segmentDefaultRole    String?
  installedAt           DateTime?
  decommissionedAt      DateTime?
  source                RecordSource             @default(IMPORT)
  importBatchId         String?
  endpointA             SegmentEndpoint          @relation("LinkSegmentEndpointA", fields: [endpointAId], references: [id])
  endpointB             SegmentEndpoint          @relation("LinkSegmentEndpointB", fields: [endpointBId], references: [id])
  cable                 Cable?                   @relation(fields: [cableId], references: [id])
  importBatch           ImportBatch?             @relation(fields: [importBatchId], references: [id])
  fibers                SegmentFiber[]
  endpointMappings      SegmentEndpointMapping[]
  serviceAllocations    ServiceAllocation[]
  serviceRouteHops      ServiceRouteHop[]
  utilizationMetrics    UtilizationMetric[]      @relation("SegmentUtilizationMetric")
  alertEvents           AlertEvent[]             @relation("SegmentAlertEvent")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([sitePairKey])
  @@index([segmentGroupName])
  @@index([segmentSequence])
  @@index([sourceSegmentKey])
  @@index([spanType])
  @@index([inventoryClass])
  @@index([cableId])
  @@index([status])
  @@index([status, updatedAt])
  @@index([allocatedServiceCode])
  @@index([segmentDefaultRole])
  @@index([importBatchId])
}

model SegmentFiber {
  id                  String             @id @default(cuid())
  segmentId           String
  fiberNumber         Int
  status              ResourceStatus     @default(AVAILABLE)
  serviceId           String?
  serviceRouteId      String?
  serviceAllocationId String?
  serviceCode         String?
  allocationGroup     String?
  pathOrder           Int?
  isJumper            Boolean            @default(false)
  label               String?
  tubeNumber          Int?
  tubeColor           String?
  tubeLabel           String?
  fiberPortNumber     Int?
  fiberLabel          String?
  allocatedAt         DateTime?
  remarks             String?
  segment             LinkSegment        @relation(fields: [segmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service             Service?           @relation(fields: [serviceId], references: [id])
  serviceRoute        ServiceRoute?      @relation(fields: [serviceRouteId], references: [id])
  serviceAllocation   ServiceAllocation? @relation(fields: [serviceAllocationId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([segmentId, fiberNumber])
  @@index([segmentId, status])
  @@index([serviceCode])
  @@index([serviceId])
  @@index([serviceRouteId])
  @@index([serviceAllocationId])
  @@index([allocationGroup])
}

model SegmentEndpointMapping {
  id                 String            @id @default(cuid())
  segmentId          String
  importStagingRowId String?
  localSiteCode      String?
  localRackCode      String?
  localOdfCode       String?
  localPortLabel     String?
  farSiteCode        String?
  farEndpointLabel   String?
  farRackCode        String?
  farOdfCode         String?
  farPortLabel       String?
  localPortGroupId   String?
  farPortGroupId     String?
  fiberNumbersJson   String?
  serviceCode        String?
  childTopologyRole  String?
  tag                String?
  // Comma-separated set of canonical site keys that are jumpers on this mapping.
  // Previously added at runtime via raw SQL; now schema-managed.
  jumperSiteCode     String?
  status             ResourceStatus    @default(AVAILABLE)
  source             RecordSource      @default(IMPORT)
  remarks            String?
  segment            LinkSegment       @relation(fields: [segmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  importStagingRow   ImportStagingRow? @relation(fields: [importStagingRowId], references: [id])
  localPortGroup     PortGroup?        @relation("SegmentEndpointMappingLocalPortGroup", fields: [localPortGroupId], references: [id])
  farPortGroup       PortGroup?        @relation("SegmentEndpointMappingFarPortGroup", fields: [farPortGroupId], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([segmentId])
  @@index([segmentId, status])
  @@index([importStagingRowId])
  @@index([serviceCode])
  @@index([serviceCode, status])
  @@index([childTopologyRole])
  @@index([tag])
  @@index([jumperSiteCode])
  @@index([localSiteCode, farSiteCode])
  @@index([localSiteCode, status])
  @@index([farSiteCode, status])
  @@index([localOdfCode, localPortLabel])
  @@index([farOdfCode, farPortLabel])
  @@index([localPortGroupId])
  @@index([farPortGroupId])
}

model Service {
  id            String              @id @default(cuid())
  serviceCode   String              @unique
  serviceName   String
  serviceType   String
  customerName  String?
  status        ServiceStatus       @default(ACTIVE)
  remarks       String?
  routes        ServiceRoute[]
  allocations   ServiceAllocation[]
  segmentFibers SegmentFiber[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([serviceType])
  @@index([status])
}

model ServiceRoute {
  id             String              @id @default(cuid())
  serviceId      String
  routeName      String
  routeType      RouteType
  priority       Int                 @default(1)
  isActive       Boolean             @default(true)
  slaClass       String?
  protectionMode String?
  remarks        String?
  service        Service             @relation(fields: [serviceId], references: [id])
  hops           ServiceRouteHop[]
  allocations    ServiceAllocation[]
  segmentFibers  SegmentFiber[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([serviceId, routeType])
  @@index([isActive])
}

model ServiceAllocation {
  id                   String           @id @default(cuid())
  serviceId            String
  serviceRouteId       String?
  segmentId            String
  allocationGroup      String
  pathOrder            Int
  fromSiteId           String?
  toSiteId             String?
  endpointAId          String?
  endpointBId          String?
  endpointAPortGroupId String?
  endpointBPortGroupId String?
  fiberStart           Int
  fiberEnd             Int
  fiberNumbersJson     String
  status               ResourceStatus   @default(USED)
  isJumper             Boolean          @default(false)
  isProtection         Boolean          @default(false)
  pathLabel            String?
  remarks              String?
  service              Service          @relation(fields: [serviceId], references: [id])
  serviceRoute         ServiceRoute?    @relation(fields: [serviceRouteId], references: [id])
  segment              LinkSegment      @relation(fields: [segmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fromSite             Site?            @relation("ServiceAllocationFromSite", fields: [fromSiteId], references: [id])
  toSite               Site?            @relation("ServiceAllocationToSite", fields: [toSiteId], references: [id])
  endpointA            SegmentEndpoint? @relation("ServiceAllocationEndpointA", fields: [endpointAId], references: [id])
  endpointB            SegmentEndpoint? @relation("ServiceAllocationEndpointB", fields: [endpointBId], references: [id])
  endpointAPortGroup   PortGroup?       @relation("ServiceAllocationEndpointAPortGroup", fields: [endpointAPortGroupId], references: [id])
  endpointBPortGroup   PortGroup?       @relation("ServiceAllocationEndpointBPortGroup", fields: [endpointBPortGroupId], references: [id])
  fibers               SegmentFiber[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([serviceId])
  @@index([serviceRouteId])
  @@index([segmentId])
  @@index([allocationGroup])
  @@index([pathOrder])
  @@index([fromSiteId, toSiteId])
  @@index([status])
}

model ServiceRouteHop {
  id              String       @id @default(cuid())
  serviceRouteId  String
  hopOrder        Int
