enum PendingDeletionStatus {
  PENDING
  CANCELLED
  PURGED
}

enum PendingDeletionEntityType {
  ODF
  SEGMENT
}

// Delayed-deletion (soft-delete hold) ledger for ODF rows and ODF Mapping
// segments. A delete request with zero live dependencies no longer purges
// immediately: it parks here for a 24-working-hour reversal window computed on
// the GCC business-day calendar (Sun-Thu working week; weekends and configured
// national holidays pause the countdown). Intentionally relation-free so the
// purge worker can hard-delete the target rows without FK coupling.
model PendingDeletion {
  id               String                    @id @default(cuid())
  entityType       PendingDeletionEntityType
  entityId         String
  entityLabel      String?
  // Groups a multi-select segment deletion; a two-adjacent-segment group with
  // mergeTopology=true purges as a Reverse Split (boundary merge) instead of a
  // plain hard delete.
  deleteGroupId    String?
  mergeTopology    Boolean                   @default(false)
  requestedById    String?
  requestedAt      DateTime                  @default(now())
  // GCC-aware purge deadline cached at request time; the sweeper re-derives the
  // effective deadline from requestedAt so later-added holidays still extend it.
  scheduledPurgeAt DateTime
  status           PendingDeletionStatus     @default(PENDING)
  cancelledAt      DateTime?
  purgedAt         DateTime?
  purgeError       String?
  reason           String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([status, scheduledPurgeAt])
  @@index([entityType, entityId, status])
  @@index([deleteGroupId])
}

// Isolated Attachments/Documents module. Intentionally has NO relations to
// LinkSegment/Site so it stays decoupled from split/rehome/trace/ODF/import
// logic. Files live on disk under storage/attachments/**; only metadata is here.
model SegmentAttachment {
  id               String   @id @default(uuid())
  segmentId        String?
  siteId           String?
  documentType     String // FDD, ODF_PHOTO, OTDR_REPORT, ATP, HANDOVER, SITE_PHOTO, OTHER
  originalFilename String
  storedFilename   String
  storagePath      String
  mimeType         String
  fileSizeBytes    Int
  uploadedBy       String
  uploadedAt       DateTime @default(now())
  remarks          String?
  site             Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([segmentId])
  @@index([siteId])
  @@index([documentType])
  @@index([uploadedAt])
}
