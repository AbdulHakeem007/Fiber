# PostgreSQL connection string. Managed services usually need SSL: append &sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
APP_NAME="Fiber Inventory Portal"
AUTH_SECRET="replace-with-a-strong-random-secret"
SECRETS_ENCRYPTION_KEY="replace-with-a-different-strong-random-secret"
FEATURE_DEMO_DATA=false

# Optional. Use a local folder or Windows UNC share for uploaded site documents.
# Example Windows network share: ATTACHMENT_STORAGE_ROOT="\\\\fileserver\\fiber-documents"
# Default when unset: ./storage/attachments
ATTACHMENT_STORAGE_ROOT=""

# Optional. Base URL the "service trace search" site stencils are served from.
# Physical assets live in public/network-stencils/site and are served at the
# root-relative URL below, which stays valid after the project is moved to a new
# device or path. Only override this if the stencils are relocated OUTSIDE the
# app bundle after a move (e.g. a CDN or shared asset host). Must be a URL path
# or absolute URL — never an OS filesystem path (C:\...). Default: /network-stencils/site
NEXT_PUBLIC_SITE_STENCIL_DIR="/network-stencils/site"
